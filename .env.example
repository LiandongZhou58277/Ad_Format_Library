# Copy to .env and fill in the real values. .env is gitignored — never commit it.
# Only needed to run `node migrate.js` (or to run the app locally against the cloud stores).

# Vercel Blob → your Blob store page → Quickstart → ".env.local" tab
BLOB_READ_WRITE_TOKEN=

# Upstash Redis → your Redis database page → Quickstart / ".env.local" tab
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too)
KV_REST_API_URL=
KV_REST_API_TOKEN=
